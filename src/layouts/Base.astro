---
import type { ComponentProps } from "astro/types";
import { i18n } from "astro:config/client";
import { Font } from "astro:assets";
import { Seo } from "@datocms/astro";
import Border from "~/components/Border.astro";
import Button from "~/components/Button.astro";
import EnableJavascript from "~/components/EnableJavascript.astro";
import Footer from "~/components/Footer.astro";
import IconSprite from "~/components/IconSprite.astro";
import Logo from "~/components/Logo.astro";
import Menu from "~/components/Menu.astro";
import RememberLocale from "~/components/RememberLocale.astro";
import SetColorScheme from "~/components/SetColorScheme.astro";
import ViewportState from "~/components/ViewportState.astro";
import { getMenuItems } from "~/datocms/menu";
import { t, toLocale } from "~/i18n";
import { imgix_host } from "~/generated/site.json";

import "~/generated/tokens.css";
import "~/styles/a11y.css";
import "~/styles/reset.css";
import "~/styles/typography.css";

type Props = {
  locale?: string;
  title?: string;
  seoMetaTags?: ComponentProps<typeof Seo>["data"];
  translations?: Array<{ locale: string; path: string }>;
};

const {
  locale = i18n?.defaultLocale ?? "en",
  title,
  seoMetaTags = [],
  translations = [],
} = Astro.props;
const xDefault = translations.find((t) => t.locale === i18n?.defaultLocale);
const { origin, pathname } = Astro.url;

const canonical = `${origin}${pathname}`;

const menuItems = await getMenuItems(toLocale(locale));
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    {/* minimum-scale stops mobile Chrome from zooming out to fit the open menu without JS. */}
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href={`https://${imgix_host}`} crossorigin />
    <Seo data={seoMetaTags} />

    <EnableJavascript />
    <ViewportState />
    <SetColorScheme />
    {/* Error pages have no translations and render in the default locale, which must not overwrite the cookie. */}
    {translations.length > 0 && <RememberLocale />}

    <Font cssVariable="--font-source-sans" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-dash-casual" preload />
    <link rel="canonical" href={canonical} />
    {
      translations.map(({ locale, path }) => (
        <link
          rel="alternate"
          hreflang={locale}
          href={new URL(path, Astro.site)}
        />
      ))
    }
    {
      xDefault && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(xDefault.path, Astro.site)}
        />
      )
    }
    <slot name="head" />
  </head>
  <body>
    <Button as="a" variant="highlight" class="kb-only skip-link" href="#main">
      {t("skip_to_main_content")}
    </Button>
    <Button as="a" variant="highlight" class="kb-only skip-link" href="#navigation">
      {t("skip_to_navigation")}
    </Button>
    <div class="page">
      <Menu
        items={menuItems}
        currentPageTitle={title}
        locale={locale}
        translations={translations}
      />
      <div class="content">
        {/* Sticky, so jumping here keeps the vertical scroll position. */}
        <span id="page" class="page-anchor"></span>
        <Border class="content__border">
          <Border class="header">
            <header>
              <a href="/">
                <Logo />
                <span class="sr-only">Luuk Brauckmann</span>
              </a>
            </header>
          </Border>

          {
            Astro.slots.has("back") && (
              <div class="back">
                <slot name="back" />
              </div>
            )
          }

          <main id="main">
            <slot />
          </main>

          <Footer items={menuItems} />
        </Border>
      </div>
    </div>

    <IconSprite />
  </body>
</html>

<style>
  html {
    container-type: inline-size;
    background-color: var(--color-surface-canvas);
    scrollbar-gutter: stable;
    color-scheme: dark;

    @media (prefers-reduced-motion: no-preference) {
      scroll-behavior: smooth;
    }
  }

  @media (width <= 800px) {
    /* Without JS the viewport scrolls onto the open menu; rtl keeps the page in view as it appears. */
    :global(html:not(.js-enabled)) {
      direction: rtl;
      overflow-x: hidden;
    }

    :global(html:not(.js-enabled):has(#navigation:target)) {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }

    /* Fixed rather than overflow: hidden on the root, which doesn't stop scrolling in iOS Safari. */
    :global(html[data-menu-open] body) {
      position: fixed;
      inset-inline: 0;
      inset-block-start: calc(-1 * var(--menu-scroll-y));
    }
  }

  :global(:root) {
    --header-block-size: calc(var(--typography-scale-subtitle) + 2 * var(--spacing-size-xs));
  }

  .skip-link:focus {
    position: fixed;
    z-index: 1000;
    translate: -50% 0;
    inset-block-start: calc(var(--header-block-size) + var(--spacing-size-xs));
    inset-inline-start: 50%;
  }

  .page {
    --menu-width: min(20rem, 80cqi);

    display: grid;
    direction: ltr;
    min-block-size: 100dvh;
    overflow-x: clip;

    @container (width <= 800px) {
      grid-template-columns: 100cqi;
    }

    @container (width > 800px) {
      grid-template-columns: minmax(0, 200px) min(600px, 100%);
      grid-template-areas: "left center";
      justify-content: center;
    }

    @container (width > 1000px) {
      grid-template-columns: minmax(0, 200px) min(600px, 100%) minmax(0, 200px);
      grid-template-areas: "left center right";
    }
  }

  @container (width > 800px) {
    .page > :global(.menu) {
      grid-area: left;
    }

    .content {
      grid-area: center;
    }
  }

  @container (width <= 800px) {
    :global(html:not(.js-enabled)) .page {
      inline-size: max-content;
    }

    :global(html:not(.js-enabled)):has(:global(#navigation:target)) .page {
      grid-template-columns: var(--menu-width) 100cqi;
    }

    :global(html:not(.js-enabled)) .page > :global(.menu) {
      scroll-snap-align: start;
    }

    :global(html:not(.js-enabled)) .content {
      scroll-snap-align: end;
    }

    :global(.js-enabled) .page > :global(*) {
      grid-area: 1 / 1;
    }

    :global(html[data-menu-open]) .content {
      translate: var(--menu-width) 0;
      opacity: 0.4;
      filter: blur(8px);
    }

    @media (prefers-reduced-motion: no-preference) {
      :global(.js-enabled) .content {
        transition:
          translate var(--motion-transition) ease,
          opacity var(--motion-transition) ease,
          filter var(--motion-transition) ease;
      }
    }
  }

  main {
    display: flex;
    flex-direction: column;
    grid-area: stack;
    gap: var(--spacing-size-xl);
    padding-block: var(--spacing-size-xl) var(--spacing-size-xxl);
    overflow: hidden;

    &:has(> :global(.hero:first-child), > :global(:first-child > .hero:first-child)) {
      grid-row: header-start / stack-end;
      padding-block-start: 0;
    }

    /* Bordered blocks carry their own spacing; normal flow lets their -1px margins collapse. */
    &:has(> :global(.blocks)) {
      padding-block: 0;
    }

    &:has(> :global(.blocks > :first-child > .hero)) {
      grid-row: header-start / stack-end;
    }
  }

  main > :global(article) {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-size-xl);
  }

  .content {
    container-type: inline-size;

    @container (width > 800px) {
      padding: var(--spacing-size-xs);
    }
  }

  .content__border {
    display: grid;
    position: relative;
    grid-template-rows: auto 1fr auto;
    grid-template-areas:
      "header"
      "stack"
      "footer";
    block-size: 100%;
  }

  /* Tucked under the header, over the hero banner when there is one. */
  .back {
    position: absolute;
    z-index: 1;
    inset-block-start: calc(var(--header-block-size) + var(--spacing-size-xs));
    inset-inline-start: var(--spacing-size-l);
    text-shadow: 0 0 8px rgb(0 0 0 / 0.4);
  }

  .page-anchor {
    display: block;
    position: sticky;
    inset-block-start: 0;
    block-size: 0;
  }

  /* In its own grid row so it reserves space (content sits below it, no
     overlap at rest), but sticky so it pins to the top on scroll. The
     scroll-state container query reveals the divider + gradient once stuck. */
  .header {
    display: block;
    position: sticky;
    container: site-header / scroll-state;
    grid-area: header;
    align-self: start;
    z-index: 999;
    inset-block-start: -1px;
    border-block-end-color: transparent;

    &::after {
      position: absolute;
      transform: translateY(100%);
      opacity: 0;
      transition: opacity var(--motion-feedback) ease-out;
      inset-block-end: 0px;
      inset-inline: 0px;
      background: linear-gradient(
        to bottom,
        var(--color-surface-base),
        transparent
      );
      height: var(--spacing-size-l);
      pointer-events: none;
      content: "";
    }
  }

  .header header {
    display: flex;
    justify-content: center;
    align-items: center;
    transition:
      --header-fill var(--motion-feedback) ease-out,
      --header-opacity var(--motion-feedback) ease-out,
      border-block-end-color var(--motion-feedback) ease-out;
    border-block-end: 1px solid transparent;
    background-color: var(--color-surface-canvas);
    padding-inline: var(--spacing-size-xxs);
    block-size: var(--header-block-size);

    @supports (container-type: scroll-state) {
      background-color: transparent;
      background-image: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--color-surface-canvas) var(--header-opacity), transparent)
          var(--header-fill),
        transparent calc(var(--header-fill) + 50%)
      );
    }
  }

  @supports (container-type: scroll-state) {
    .header :global(.logo) {
      transition: filter var(--motion-feedback) ease-out;
      filter: drop-shadow(0 0 8px rgb(0 0 0 / 0.4));
    }
  }

  @property --header-fill {
    syntax: "<percentage>";
    inherits: false;
    initial-value: -50%;
  }

  @property --header-opacity {
    syntax: "<percentage>";
    inherits: false;
    initial-value: 0%;
  }

  @container site-header scroll-state(stuck: top) {
    /* Once stuck: the background fills down first, then the shadow and border fade in. */
    .header::after {
      opacity: 1;
      transition-delay: var(--motion-feedback);
    }

    .header header {
      --header-fill: 100%;
      --header-opacity: 100%;
      transition-delay: 0s, 0s, var(--motion-feedback);
      border-block-end-color: var(--color-surface-base);
    }

    .header :global(.logo) {
      filter: none;
    }
  }
</style>
