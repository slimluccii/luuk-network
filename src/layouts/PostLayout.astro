---
import type { CollectionEntry } from "astro:content";
import type { LoaderQuery } from "~/generated/datocms";
import type { CdaStructuredTextValue } from "@datocms/astro";
import Base from "~/layouts/Base.astro";
import BackLink from "~/components/BackLink.astro";
import HeroMeta from "~/components/HeroMeta.astro";
import HeroTitle from "~/components/HeroTitle.astro";
import TagList from "~/components/TagList.astro";
import StructuredText from "~/components/StructuredText.astro";
import { d, t } from "~/i18n";

type Props = {
  entry: CollectionEntry<"pages">;
};

type PostData = LoaderQuery["allPosts"][number] & {
  locale: string;
  indexPage: { title: string | null; path: string };
  translations: Array<{ locale: string; path: string }>;
};

const { entry } = Astro.props;
const data = entry.data as unknown as PostData;

const eyebrow = [data.indexPage.title, data.category?.name].filter(Boolean);
const sourceHost = data.sourceUrl ? new URL(data.sourceUrl).hostname.replace(/^www\./, "") : null;
const tags = data.tags.map((tag) => tag.name).filter((name): name is string => name != null);
const dateFormat: Intl.DateTimeFormatOptions = {
  weekday: "short",
  month: "short",
  day: "numeric",
  year: "numeric",
};
---

<Base
  locale={data.locale}
  title={data.title ?? undefined}
  seoMetaTags={data._seoMetaTags}
  translations={data.translations}
>
  <BackLink slot="back" href={data.indexPage.path} overview={data.indexPage.title ?? ""} />
  <article class="post">
    <header class="post__header">
      {
        eyebrow.length > 0 && (
          <HeroMeta>
            {eyebrow.map((part, index) => (
              <>
                {index > 0 && (
                  <>
                    {" "}
                    <span class="post__separator" aria-hidden="true">
                      •
                    </span>{" "}
                  </>
                )}
                {part}
              </>
            ))}
          </HeroMeta>
        )
      }
      <HeroTitle>{data.title}</HeroTitle>
      <div class="post__meta">
        {
          data._firstPublishedAt && (
            <time datetime={data._firstPublishedAt}>{d(data._firstPublishedAt, dateFormat)}</time>
          )
        }
        {tags.length > 0 && <TagList tags={tags} />}
      </div>
      {
        data.sourceUrl && (
          <p class="post__source">
            {t("originally_published_on")}{" "}
            <a href={data.sourceUrl}>
              {sourceHost}
              <span aria-hidden="true"> ↗</span>
            </a>
          </p>
        )
      }
    </header>

    {data.content && <StructuredText data={data.content as CdaStructuredTextValue} />}
  </article>
</Base>

<style>
  .post__header {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-size-xs);
    padding-inline: var(--spacing-size-l);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-size-s);
    margin-block-start: var(--spacing-size-xs);
    font-size: var(--typography-scale-caption);
  }

  .post__separator {
    margin-inline: 0.25em;
  }

  .post__source {
    opacity: var(--opacity-muted);
    margin: 0;
    font-size: var(--typography-scale-caption);

    a {
      color: inherit;
    }
  }
</style>
