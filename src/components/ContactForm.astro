---
import type { HTMLAttributes } from "astro/types";
import { actions, isInputError } from "astro:actions";
import { CONTACT_FORM_SECRET } from "astro:env/server";
import { FRIENDLY_CAPTCHA_SITEKEY } from "astro:env/client";
import Button from "~/components/Button.astro";
import { createFormToken } from "~/actions/contact/form-token";
import { t } from "~/i18n";

type Props = HTMLAttributes<"form">;

const { class: className, ...props } = Astro.props;

const sent = Astro.url.searchParams.get("sent") === "contact";
const error = Astro.getActionResult(actions.contact)?.error;
const invalid = error && isInputError(error) ? error.fields : {};
const rejected = error?.code === "FORBIDDEN";
const failed = error && !rejected && !isInputError(error);
const token = await createFormToken(CONTACT_FORM_SECRET);
---

{
  sent ? (
    <p class="contact-form__status" role="status" tabindex="-1" data-contact-focus>
      {t("contact_sent")}
    </p>
  ) : (
    <>
      <form
        class:list={["contact-form", className]}
        method="POST"
        action={actions.contact}
        {...props}
      >
        {failed && (
          <p
            class="contact-form__status contact-form__status--failed"
            role="alert"
            tabindex="-1"
            data-contact-focus
          >
            {t("contact_failed")}
          </p>
        )}
        <div class="contact-form__field">
          <label for="contact-name">{t("contact_name")}</label>
          <input
            id="contact-name"
            name="name"
            autocomplete="name"
            maxlength="100"
            required
            aria-invalid={invalid.name ? "true" : undefined}
            aria-describedby={invalid.name ? "contact-name-error" : undefined}
            aria-errormessage="contact-name-error"
          />
          <p class="contact-form__error" id="contact-name-error">
            {t("contact_name_error")}
          </p>
        </div>
        <div class="contact-form__field">
          <label for="contact-email">{t("contact_email")}</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            maxlength="254"
            required
            aria-invalid={invalid.email ? "true" : undefined}
            aria-describedby={invalid.email ? "contact-email-error" : undefined}
            aria-errormessage="contact-email-error"
          />
          <p class="contact-form__error" id="contact-email-error">
            {t("contact_email_error")}
          </p>
        </div>
        <div class="contact-form__field">
          <label for="contact-message">{t("contact_message")}</label>
          <textarea
            id="contact-message"
            name="message"
            rows="6"
            maxlength="5000"
            required
            aria-invalid={invalid.message ? "true" : undefined}
            aria-describedby={invalid.message ? "contact-message-error" : undefined}
            aria-errormessage="contact-message-error"
          />
          <p class="contact-form__error" id="contact-message-error">
            {t("contact_message_error")}
          </p>
        </div>
        <div class="contact-form__trap" aria-hidden="true">
          <label>
            Website
            <input name="website" tabindex="-1" autocomplete="off" />
          </label>
        </div>
        <input type="hidden" name="token" value={token} />
        <div class="contact-form__captcha" data-invalid={rejected ? "" : undefined}>
          <div class="contact-form__widget" data-sitekey={FRIENDLY_CAPTCHA_SITEKEY} />
          <p
            class="contact-form__error"
            id="contact-captcha-error"
            tabindex="-1"
            data-contact-focus={rejected ? "" : undefined}
          >
            {t("contact_captcha_error")}
          </p>
        </div>
        <Button type="submit" icon="envelope">
          {t("contact_send")}
        </Button>
      </form>
      <p class="contact-form__requires-js">{t("contact_requires_javascript")}</p>
    </>
  )
}

<script>
  import { FriendlyCaptchaSDK } from "@friendlycaptcha/sdk";

  document.querySelector<HTMLElement>("[data-contact-focus]")?.focus();

  const form = document.querySelector<HTMLFormElement>(".contact-form");
  const captcha = form?.querySelector<HTMLElement>(".contact-form__captcha");
  const element = captcha?.querySelector<HTMLElement>(".contact-form__widget");

  if (form && captcha && element) {
    const widget = new FriendlyCaptchaSDK().createWidget({
      element,
      sitekey: element.dataset.sitekey!,
      theme: "dark",
    });

    element.addEventListener("frc:widget.complete", () => {
      delete captcha.dataset.invalid;
    });

    form.addEventListener("submit", (event) => {
      if (widget.getState() === "completed") return;

      event.preventDefault();
      captcha.dataset.invalid = "";
      captcha.querySelector<HTMLElement>(".contact-form__error")?.focus();
    });
  }
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-size-m);
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-size-s);
    inline-size: 100%;
    max-inline-size: 40rem;

    & label {
      font-weight: 700;
      font-size: var(--typography-scale-caption);
      line-height: 1.5;
    }

    & input,
    & textarea {
      padding: var(--spacing-size-s) var(--spacing-size-m);
      border: 1px solid var(--color-surface-raised);
      background-color: transparent;
      color: inherit;
      font-weight: 500;
      line-height: 1.5;

      &:hover {
        border-color: var(--color-brand-primary);
      }
    }

    & textarea {
      resize: vertical;
    }

    & :is(input, textarea):is(:user-invalid, [aria-invalid="true"]) {
      border-color: var(--color-intent-critical);
    }
  }

  .contact-form__error {
    display: none;
    margin: 0;
    color: var(--color-intent-critical);
    font-weight: 500;
    font-size: var(--typography-scale-caption);
    line-height: 1.5;

    :is(:user-invalid, [aria-invalid="true"]) + &,
    [data-invalid] > & {
      display: block;
    }
  }

  .contact-form__trap {
    position: absolute;
    inset-inline-start: -100vw;
  }

  .contact-form__status {
    margin: 0;
  }

  .contact-form__status--failed {
    color: var(--color-intent-critical);
  }

  :global(html:not(.js-enabled)) .contact-form,
  :global(.js-enabled) .contact-form__requires-js {
    display: none;
  }
</style>
