---
import type { HTMLAttributes } from "astro/types";
import { t } from "~/i18n";

type Props = HTMLAttributes<"ul"> & {
  current: string;
  translations: Array<{ locale: string; path: string }>;
};

const { current, translations, class: className, ...props } = Astro.props;
const locales = [...translations].sort((a, b) =>
  a.locale.localeCompare(b.locale)
);

// Endonym (the language's own name), so each option reads naturally to a
// speaker of that language: "English", "Nederlands".
const languageName = (locale: string) =>
  new Intl.DisplayNames([locale], { type: "language" }).of(locale) ??
  locale.toUpperCase();
---

<ul
  class:list={["locale-selector", className]}
  role="list"
  aria-label={t("language")}
  {...props}
>
  {
    locales.map(({ locale, path }) => (
      <li>
        <a
          class="locale-selector__link link-plain"
          href={path}
          hreflang={locale}
          lang={locale}
          aria-current={locale === current ? "page" : undefined}
        >
          {languageName(locale)}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .locale-selector {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-size-s);
    margin: 0;
    padding: 0;
    padding-block: var(--spacing-size-xs);
    list-style: none;
  }

  .locale-selector__link {
    display: block;
    opacity: var(--opacity-muted);
    transition: var(--motion-feedback) ease;
    text-decoration: underline;
    text-decoration-color: transparent;

    &:hover {
      opacity: 1;
      text-decoration-color: currentColor;
    }

    &[aria-current="page"] {
      opacity: 1;
      font-weight: 500;
    }
  }
</style>
