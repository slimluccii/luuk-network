---
import type { CtaBlockFragment } from "~/generated/datocms";
import Button from "~/components/Button.astro";
import Section from "~/components/Section.astro";
import SectionActions from "~/components/SectionActions.astro";
import SectionContent from "~/components/SectionContent.astro";
import SectionHeader from "~/components/SectionHeader.astro";
import SectionTitle from "~/components/SectionTitle.astro";
import { getContactFormPath } from "~/datocms/entries";
import { getLocale } from "~/i18n";

type Props = {
  block: CtaBlockFragment;
};

const { block } = Astro.props;
const titleId = `cta-${crypto.randomUUID()}`;
const contactPath = await getContactFormPath(getLocale());
---

<Section class="cta" aria-labelledby={titleId}>
  <SectionHeader>
    <SectionTitle id={titleId}>{block.title}</SectionTitle>
  </SectionHeader>
  {
    block.text && (
      <SectionContent>
        <p class="cta__text">{block.text}</p>
      </SectionContent>
    )
  }
  {
    contactPath && (
      <SectionActions>
        <Button as="a" icon="envelope" href={contactPath}>
          {block.label}
        </Button>
      </SectionActions>
    )
  }
</Section>

<style>
  .cta {
    background-color: var(--color-surface-base);
  }

  .cta__text {
    margin: 0;
  }
</style>
