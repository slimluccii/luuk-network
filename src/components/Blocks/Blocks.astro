---
import Border from "~/components/Border.astro";

type Props = {
  blocks: Array<Record<string, any>>;
};

const { blocks } = Astro.props;
---

<div class="blocks">
  {
    blocks.map(async (block) => {
      const blockName = block.__typename.replace("Record", "");

      try {
        const Block = (await import(`./${blockName}/${blockName}.astro`)).default;
        return (
          <Border class="blocks__item">
            <Block block={block} />
          </Border>
        );
      } catch (error) {
        console.error(`Error loading block ${blockName}`, error);
        return null;
      }
    })
  }
</div>

<style>
  .blocks__item:has(> :global(.title-block)) {
    border-block-end-color: transparent;

    &:has(+ .blocks__item) > :global(.title-block) {
      padding-block-end: 0;
    }

    & + .blocks__item {
      border-block-start-color: transparent;
    }
  }
</style>
