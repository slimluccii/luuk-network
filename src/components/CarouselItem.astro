---
import type { ComponentProps } from "astro/types";
import { Image } from "@datocms/astro";
import LinkArea from "~/components/LinkArea.astro";

type Props = {
  href: string;
  title: string;
  description: string;
  cover?: ComponentProps<typeof Image>["data"];
  meta?: string;
};

const { href, title, description, cover, meta } = Astro.props;
---

<li class="carousel-item">
  <LinkArea class="carousel-item__area">
    {
      cover && (
        <Image
          pictureClass="carousel-item__cover"
          data={cover}
          imgStyle={{
            width: "100%",
            height: "100%",
            objectFit: "cover",
            maxWidth: "none",
          }}
        />
      )
    }
    <div class="carousel-item__body">
      <hgroup class="carousel-item__header">
        {meta && <p class="carousel-item__meta">{meta}</p>}
        <h3 class="carousel-item__title">
          <a class="carousel-item__link link-plain" href={href}>
            {title}
          </a>
        </h3>
      </hgroup>
      <p class="carousel-item__description">{description}</p>
    </div>
  </LinkArea>
</li>

<style>
  .carousel-item {
    flex: 0 0 100%;
    max-inline-size: 22rem;
    scroll-snap-align: center;
  }

  .carousel-item__cover {
    display: block;
    aspect-ratio: 16 / 9;
    inline-size: 100%;
    block-size: auto;
    object-fit: cover;
  }

  .carousel-item__body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-size-xs);
    border: 1px solid var(--color-surface-raised);
    background-color: var(--color-surface-raised);
    padding: var(--spacing-size-m);
  }

  .carousel-item__header {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-size-xxs);
    margin: 0;
  }

  .carousel-item__link {
    text-decoration-line: none;
  }

  .carousel-item__area:hover .carousel-item__link,
  .carousel-item__link:focus-visible {
    color: var(--color-brand-highlight);
    text-decoration-line: underline;
  }

  .carousel-item__meta {
    opacity: var(--opacity-muted);
    margin: 0;
    font-size: var(--typography-scale-caption);
  }

  .carousel-item__title {
    margin: 0;
  }

  .carousel-item__description {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    margin: 0;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    min-block-size: 3lh;
    overflow: hidden;
  }
</style>
