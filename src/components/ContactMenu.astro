---
import type { HTMLAttributes } from "astro/types";
import SplitButton from "~/components/SplitButton.astro";
import Icon from "~/components/Icon.astro";
import { socialLinks } from "~/data/contact";
import { getContactFormPath } from "~/datocms/entries";
import { getLocale, t } from "~/i18n";

type Props = HTMLAttributes<"a">;

const github = socialLinks.find((link) => link.icon === "github")!;
const contactPath = await getContactFormPath(getLocale());
const links = [
  ...(contactPath
    ? [{ href: contactPath, icon: "envelope" as const, title: t("contact"), external: false }]
    : []),
  ...socialLinks
    .filter((link) => link !== github)
    .map((link) => ({ ...link, external: true })),
];
---

<SplitButton
  as="a"
  variant="secondary"
  icon={github.icon}
  href={github.href}
  target="_blank"
  rel="noopener noreferrer"
  menuLabel={t("more_contact_options")}
  {...Astro.props}
>
  {github.title}
  <ul slot="menu" class="contact-menu__list" role="list">
    {
      links.map(({ href, icon, title, external }) => (
        <li>
          <a
            class="contact-menu__link link-plain"
            href={href}
            {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          >
            <Icon name={icon} />
            {title}
          </a>
        </li>
      ))
    }
  </ul>
</SplitButton>

<style>
  .contact-menu__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-menu__link {
    display: flex;
    align-items: center;
    gap: var(--spacing-size-xs);
    padding: var(--spacing-size-xs) var(--spacing-size-s);
    text-decoration: none;

    &:hover,
    &:focus-visible {
      background-color: var(--color-surface-raised);
    }
  }
</style>
