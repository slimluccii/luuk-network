---
import LinkArea from "~/components/LinkArea.astro";

type Entry = {
  href: string;
  title: string;
  description?: string;
  meta?: string;
};

interface Props {
  entries: Entry[];
  headingLevel?: 2 | 3;
}

const { entries, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
---

<ul class="entry-list">
  {
    entries.map(({ href, title, description, meta }) => (
      <li>
        <LinkArea class="entry">
          <hgroup class="entry__header">
            {meta && <p class="entry__meta">{meta}</p>}
            <Heading class="entry__title">
              <a class="entry__link" href={href}>
                {title}
              </a>
            </Heading>
          </hgroup>
          {description && <p class="entry__description">{description}</p>}
        </LinkArea>
      </li>
    ))
  }
</ul>

<style>
  .entry-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-size-xl);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entry {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-size-xs);
  }

  .entry__header {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-size-xxs);
    margin: 0;
  }

  .entry__title {
    margin: 0;
    font-size: var(--typography-scale-subtitle);
  }

  .entry__link {
    color: inherit;
    text-decoration-line: none;
  }

  .entry:hover .entry__link,
  .entry__link:focus-visible {
    text-decoration-line: underline;
  }

  .entry__description {
    margin: 0;
  }

  .entry__meta {
    opacity: var(--opacity-muted);
    margin: 0;
    font-size: var(--typography-scale-caption);
  }
</style>
